# Copy this file to `.env` (or export these vars) before running the backend.
# The application reads them through ${VAR:default} placeholders in application.yml.

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skillswap_db
DB_USER=root
DB_PASS=change_me

# â”€â”€ JWT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Must be at least 64 characters. Generate one with:
#   openssl rand -base64 64
JWT_SECRET=replace_with_a_random_64_char_secret_at_least

# â”€â”€ Email notifications (SMTP) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# In-app notifications always work. When these are set, every notification
# is also emailed to the recipient's registered address.
#
# Gmail example (use an App Password, not your normal password):
#   https://myaccount.google.com/apppasswords
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your.address@gmail.com
#   MAIL_PASSWORD=your_16_char_app_password
#   MAIL_FROM=your.address@gmail.com
#
# Other providers: Brevo smtp-relay.brevo.com:587,
#                  Mailtrap sandbox.smtp.mailtrap.io:2525
MAIL_ENABLED=true
# Leave blank until you have real SMTP credentials.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional. Falls back to MAIL_USERNAME when empty.
MAIL_FROM=

# Port 587 uses STARTTLS. For port 465 set MAIL_STARTTLS=false,
# MAIL_STARTTLS_REQUIRED=false and MAIL_SSL_ENABLE=true.
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLE=false
MAIL_SMTP_AUTH=true

# Timeouts in milliseconds so a dead SMTP server cannot hold request threads.
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000

# Used for the "Open SkillSwap" links inside emails.
APP_FRONTEND_URL=http://localhost:5173
